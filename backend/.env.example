# Server
PORT=8080
ENV=development
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# 第三方视频平台 OAuth（里程碑一）
# 抖音开放平台 https://open.douyin.com/
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=
DOUYIN_SCOPE=user_info,video.list,video.publish
# 小红书开放平台
XIAOHONGSHU_CLIENT_ID=
XIAOHONGSHU_CLIENT_SECRET=
XIAOHONGSHU_REDIRECT_URI=
# B站开放平台 https://openhome.bilibili.com/
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=
BILIBILI_REDIRECT_URI=
# 微博开放平台 https://open.weibo.com/
WEIBO_CLIENT_ID=
WEIBO_CLIENT_SECRET=
WEIBO_REDIRECT_URI=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=3kstory

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRE_HOURS=168

# Aliyun OSS
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your_access_key
OSS_ACCESS_KEY_SECRET=your_secret_key
OSS_BUCKET_NAME=3kstory
OSS_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com

# AI Provider Selection
# Options: cloud_qwen | local_vllm | local_ollama | hybrid
AI_PROVIDER=local_vllm

# Cloud AI Services (Phase 0)
QWEN_API_KEY=your_dashscope_api_key
QWEN_API_BASE=https://dashscope.aliyuncs.com/api/v1

# Local vLLM Configuration (Phase 1 - Recommended for Production)
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL_NAME=qwen2.5-7b
VLLM_MAX_TOKENS=2048
VLLM_TIMEOUT=60

# Local Ollama Configuration (Phase 1 - Quick Testing)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5:7b
OLLAMA_MAX_TOKENS=2048
OLLAMA_TIMEOUT=60

# Third-party Video Generation APIs (Milestone 1.1)
RUNWAY_API_KEY=your_runway_api_key
RUNWAY_API_BASE=https://api.runwayml.com/v1
PIKA_API_KEY=your_pika_api_key
PIKA_API_BASE=https://api.pika.art/v1
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_API_BASE=https://api.minimax.io
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3-Fast
MINIMAX_VIDEO_RESOLUTION=768P
SEEDANCE_API_KEY=your_seedance_api_key
SEEDANCE_API_BASE=
SEEDANCE_CREATE_PATH=/contents/generations/tasks
SEEDANCE_STATUS_PATH=/contents/generations/tasks/{task_id}
SEEDANCE_VIDEO_MODEL=seedance-1-0-pro-250528
SEEDANCE_VIDEO_RESOLUTION=720p
COMFY_API_KEY=
COMFY_BASE_URL=http://localhost:8188
COMFY_WORKFLOW_DIR=.local/comfy-workflows
COMFY_OUTPUT_NODE_ID=

# Task-based routing
AI_SCRIPT_PROVIDERS=cloud_qwen,local_vllm,local_ollama
AI_NARRATION_PROVIDERS=cloud_qwen,local_vllm,local_ollama
AI_STORYBOARD_PROVIDERS=local_vllm,local_ollama,cloud_qwen
AI_SHOT_PROMPT_PROVIDERS=local_vllm,local_ollama,cloud_qwen
AI_REVIEW_PROVIDERS=cloud_qwen,local_vllm
AI_SCENE_VIDEO_PROVIDERS=comfy,local,minimax,pika,seedance,runway
AI_NARRATION_VIDEO_PROVIDERS=local,comfy,minimax,pika,seedance,runway
AI_PREVIEW_VIDEO_PROVIDERS=comfy,local,minimax,pika,seedance,runway
AI_PREMIUM_VIDEO_PROVIDERS=seedance,minimax,runway,pika,comfy,local

# Self-hosted Services (Phase 2+)
AI_IMAGE_SERVICE_URL=http://localhost:8002/v1/generate
AI_VIDEO_SERVICE_URL=http://localhost:8003/v1/generate
AI_REVIEW_SERVICE_URL=http://localhost:8004/v1/review

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=1m
