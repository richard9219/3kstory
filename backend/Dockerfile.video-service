FROM golang:1.21-alpine AS builder
WORKDIR /app

RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/local-video-service ./cmd/local-video-service

FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata ffmpeg
WORKDIR /app

COPY --from=builder /app/local-video-service ./local-video-service

ENV TZ=Asia/Shanghai
ENV LOCAL_VIDEO_PORT=8003
ENV LOCAL_VIDEO_OUTPUT_DIR=/data/videos
ENV LOCAL_VIDEO_PUBLIC_BASE=http://localhost:8003

RUN mkdir -p /data/videos
VOLUME ["/data/videos"]

EXPOSE 8003
CMD ["./local-video-service"]
